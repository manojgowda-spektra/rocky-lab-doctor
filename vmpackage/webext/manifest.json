{
  "manifest_version": 3,
  "name": "LabPilot · Rocky",
  "version": "1.0.0",
  "description": "Rocky, your lab copilot, floats beside the exact next control and guides you click-by-click — and teaches: WHY each step matters, WHAT the technology is. Click Rocky to EXPLORE: rest on or circle any control and he explains it; destructive clicks are intercepted. Glows only on a uniquely resolved control; his mood comes only from deterministic facts.",
  "permissions": [
    "storage",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://ai.azure.com/*",
    "https://*.ai.azure.com/*",
    "https://portal.azure.com/*",
    "https://*.microsoftonline.com/*",
    "https://experience.cloudlabs.ai/*",
    "https://*.cloudlabs.ai/*",
    "https://*.openai.azure.com/*",
    "https://*.services.ai.azure.com/*",
    "https://*.cognitiveservices.azure.com/*",
    "https://purview.microsoft.com/*",
    "https://*.purview.microsoft.com/*",
    "https://compliance.microsoft.com/*",
    "https://security.microsoft.com/*",
    "https://admin.microsoft.com/*",
    "https://*.office.com/*",
    "https://login.microsoftonline.com/*",
    "https://*.microsoft365.com/*",
    "https://portal.office.com/*",
    "https://*.sharepoint.com/*",
    "https://*.microsoft.com/*",
    "https://ml.azure.com/*",
    "https://*.azure.com/*",
    "https://*.portal.azure.net/*",
    "https://*.azure.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "LabPilot"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ai.azure.com/*",
        "https://*.ai.azure.com/*",
        "https://portal.azure.com/*",
        "https://*.microsoftonline.com/*",
        "https://experience.cloudlabs.ai/*",
        "https://*.cloudlabs.ai/*",
        "https://purview.microsoft.com/*",
        "https://*.purview.microsoft.com/*",
        "https://compliance.microsoft.com/*",
        "https://security.microsoft.com/*",
        "https://admin.microsoft.com/*",
        "https://*.office.com/*",
        "https://login.microsoftonline.com/*",
        "https://*.microsoft365.com/*",
        "https://portal.office.com/*",
        "https://*.sharepoint.com/*",
        "https://*.microsoft.com/*",
        "https://ml.azure.com/*",
        "https://*.azure.com/*",
        "https://*.portal.azure.net/*",
        "https://*.azure.net/*"
      ],
      "js": [
        "content/frame.js",
        "content/error-collector.js",
        "content/anchor-engine.js",
        "content/vision-matcher.js",
        "content/vision-templates.js",
        "content/rocky.js",
        "content/overlay.js",
        "content/capture.js",
        "content/foundry-kb.js",
        "content/watcher.js",
        "content/lab-context.js",
        "content/cloudlabs-kb.js",
        "content/perception.js",
        "content/completion.js",
        "content/relay.js",
        "content/world-model.js",
        "content/label-resolver.js",
        "content/guide-reader.js",
        "content/content.js",
        "content/skip.js",
        "content/controls.js",
        "content/explain-cache.js",
        "content/explore.js",
        "content/coach.js",
        "content/pilot.js",
        "content/recovery.js",
        "content/progress.js"
      ],
      "css": [
        "content/overlay.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "bundle/test-bundle.json",
        "vision-templates/*",
        "lab.json",
        "knowledge/cloudlabs-kb.json",
        "knowledge/cloudlabs-kb-full.json",
        "ai.local.json",
        "ai.json"
      ],
      "matches": [
        "https://ai.azure.com/*",
        "https://*.ai.azure.com/*",
        "https://portal.azure.com/*",
        "https://experience.cloudlabs.ai/*",
        "https://*.cloudlabs.ai/*",
        "https://purview.microsoft.com/*",
        "https://*.purview.microsoft.com/*",
        "https://compliance.microsoft.com/*",
        "https://security.microsoft.com/*",
        "https://admin.microsoft.com/*",
        "https://*.office.com/*",
        "https://login.microsoftonline.com/*",
        "https://*.microsoftonline.com/*",
        "https://*.microsoft365.com/*",
        "https://portal.office.com/*",
        "https://*.sharepoint.com/*",
        "https://*.microsoft.com/*",
        "https://ml.azure.com/*",
        "https://*.azure.com/*",
        "https://*.portal.azure.net/*",
        "https://*.azure.net/*"
      ]
    }
  ],
  "version_name": "0.7.1+9f3b8f0"
}
